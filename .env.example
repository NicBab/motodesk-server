
# ============================================================
# MOTODESK SERVER — ENVIRONMENT TEMPLATE
# Never place real secrets in this file.
# Use separate values for development, staging, and production.
# ============================================================

# APPLICATION
NODE_ENV=development
PORT=5001

# PUBLIC ORIGINS
# Use HTTPS origins in production.
# No trailing paths or query strings.
CLIENT_URL=http://localhost:3000
MARKETING_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# POSTGRESQL
# Development example only.
# Production must use an isolated managed database.
# Enable and verify TLS for the production connection.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/motodesk?schema=public

# AUTHENTICATION
# Generate a unique cryptographically random secret
# of at least 64 characters for each environment.
JWT_ACCESS_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# COOKIES
# For HTTPS staging/production:
# COOKIE_SECURE=true
#
# Use COOKIE_SAME_SITE=lax when the client and API
# are on compatible same-site domains.
# Cross-site deployments may require "none".
#
# Leave COOKIE_DOMAIN empty for host-only cookies
# unless a shared domain is explicitly needed.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# REVERSE PROXY
# Local development: 0
# Set according to the verified hosting proxy topology.
# Do not blindly trust arbitrary forwarded headers.
TRUST_PROXY=0

# GOOGLE OAUTH
# Configure all three values together or leave all blank.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# EMAIL — RESEND
RESEND_API_KEY=
EMAIL_FROM_NAME=MotoDesk
EMAIL_FROM_ADDRESS=noreply@mail.novaristechus.com

# STRIPE
# Staging: test mode with staging-specific credentials.
# Production: live mode with live credentials.
#
# Webhook secret must come from the corresponding
# Stripe webhook endpoint, not the Stripe CLI listener.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ============================================================
# DEPLOYMENT NOTES
#
# 1. Do not commit .env files containing real secrets.
# 2. Do not reuse development credentials in production.
# 3. Use the hosting provider's secret management.
# 4. Run prisma migrate deploy for deployed migrations.
# 5. Never run prisma migrate reset against production.
# 6. Never run development seed scripts against production.
# 7. Verify backups and restore before customer onboarding.
# ============================================================
