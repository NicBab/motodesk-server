generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//************************************************************** */

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
  PARTS
}

//************************************************************** */

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

//************************************************************** */

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

//************************************************************** */

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  TOKEN_REUSE
  ADMIN_REVOKED
  EXPIRED
}

//************************************************************** */

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

//************************************************************** */

enum VehicleType {
  MOTORCYCLE
  ATV
  UTV
  SCOOTER
  PWC
  SNOWMOBILE
}

//************************************************************** */

enum VehicleClassification {
  NEW
  USED
  SERVICE
}

//************************************************************** */

enum VehicleInventoryStatus {
  AVAILABLE
  RESERVED
  PENDING_SALE
  SOLD
  WHOLESALE
  UNAVAILABLE
}

//************************************************************** */

enum RepairOrderStatus {
  ESTIMATE
  AWAITING_CUSTOMER_APPROVAL
  APPROVED
  PARTS_REVIEW
  WAITING_ON_PARTS
  READY_TO_WORK
  SCHEDULED
  IN_PROGRESS
  PAUSED
  WAITING_ON_ADDITIONAL_APPROVAL
  WAITING_ON_ADDITIONAL_PARTS
  WORK_COMPLETE
  QUALITY_CHECK
  READY_FOR_PICKUP
  CASHIERED
  COMPLETED
  PICKED_UP
  CLOSED
  CANCELLED
}

enum RepairOrderPriority {
  STANDARD
  RUSH
  EMERGENCY
  HOLD
}

enum RepairOrderApprovalMethod {
  PHONE
  SMS
  EMAIL
  CUSTOMER_PORTAL
  IN_PERSON
}

enum RepairOrderCashierStatus {
  NOT_CASHIERED
  IN_PROGRESS
  COMPLETED
  VOIDED
  REVERSED
}

enum RepairOrderPickupStatus {
  NOT_READY
  READY
  COMPLETED
  REVERSED
}

enum RepairOrderPartStatus {
  NEEDS_REVIEW
  AVAILABLE
  ALLOCATED
  TO_BE_ORDERED
  ORDERED
  PARTIALLY_RECEIVED
  BACKORDERED
  RECEIVED
  PULLED
  STAGED
  ISSUED
  INSTALLED
  WAIVED
  CANCELLED
}

enum RepairOrderPartResolutionMethod {
  SHOP_INVENTORY
  ORIGINAL_PO
  ALTERNATE_VENDOR
  LOCAL_DEALER
  MANUAL_PURCHASE
  APPROVED_SUBSTITUTE
  CUSTOMER_SUPPLIED
  INVENTORY_TRANSFER
  NOT_REQUIRED
  MANAGER_OVERRIDE
}

//************************************************************** */

enum PartInventoryTransactionType {
  INITIAL
  ADJUSTMENT
  RECEIPT
  ALLOCATION
  DEALLOCATION
  ISSUE
  RETURN
  SALE
  DAMAGE
  TRANSFER
  CYCLE_COUNT

  PURCHASE_ORDERED
  PURCHASE_CANCELLED
  PURCHASE_RECEIPT
}

//************************************************************** */

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

//************************************************************** */
//************************************************************** */
//************************************************************** */

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?

  memberships Membership[]
  sessions    Session[]
  authTokens  AuthToken[]

  createdAuditEvents AuditLog[] @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//************************************************************** */

model Organization {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  email String?
  phone String?

  memberships           Membership[]
  auditLogs             AuditLog[]
  customers             Customer[]
  vehicles              Vehicle[]
  repairOrders          RepairOrder[]
  parts                 Part[]
  vendors               Vendor[]
  purchaseOrders        PurchaseOrder[]
  purchaseOrderSequence PurchaseOrderSequence?
  repairOrderSequence   RepairOrderSequence?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

//************************************************************** */

model Membership {
  id             String           @id @default(cuid())
  role           MembershipRole   @default(TECHNICIAN)
  status         MembershipStatus @default(ACTIVE)
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceAdvisorRepairOrders RepairOrder[] @relation("RepairOrderServiceAdvisor")

  technicianRepairOrders RepairOrder[] @relation("RepairOrderPrimaryTechnician")

  repairOrderStatusChanges RepairOrderStatusHistory[] @relation("RepairOrderStatusChangedBy")

  repairOrderLaborLines RepairOrderLaborLine[] @relation("RepairOrderLaborTechnician")

  partInventoryTransactions PartInventoryTransaction[] @relation("PartInventoryTransactionCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

//************************************************************** */

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  userAgent String?
  ipAddress String?

  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  revokedAt     DateTime?
  revokedReason SessionRevocationReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

//************************************************************** */

model AuthToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

//************************************************************** */
model AuditLog {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorUser   User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action       String
  resourceType String
  resourceId   String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action])
}

//************************************************************** */
model Customer {
  id             String        @id @default(cuid())
  organizationId String
  type           CustomerType  @default(INDIVIDUAL)
  vehicles       Vehicle[]
  repairOrders   RepairOrder[]
  firstName      String?
  lastName       String?
  companyName    String?

  email          String?
  phone          String?
  alternatePhone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  notes    String?
  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, lastName])
  @@index([organizationId, companyName])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

//************************************************************** */
model Vehicle {
  id             String  @id @default(cuid())
  organizationId String
  customerId     String?

  year  Int?
  make  String
  model String
  trim  String?

  vin          String?
  mileage      Int?
  color        String?
  licensePlate String?

  type         VehicleType?
  repairOrders RepairOrder[]

  classification VehicleClassification @default(SERVICE)

  inventoryStatus VehicleInventoryStatus @default(AVAILABLE)

  stockNumber String?

  listPrice Decimal? @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)

  salesperson String?

  notes    String?
  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, vin])
  @@unique([organizationId, stockNumber])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, make, model])
  @@index([organizationId, classification])
  @@index([organizationId, inventoryStatus])
}

//************************************************************** */
model RepairOrder {
  id             String @id @default(cuid())
  organizationId String
  customerId     String
  vehicleId      String

  roNumber Int

  status   RepairOrderStatus   @default(ESTIMATE)
  priority RepairOrderPriority @default(STANDARD)

  serviceAdvisorMembershipId    String?
  primaryTechnicianMembershipId String?

  promisedDate  DateTime?
  scheduledDate DateTime?

  complaint String?
  notes     String?

  taxRate          Decimal? @db.Decimal(7, 4)
  shopSuppliesRate Decimal  @default(6) @db.Decimal(7, 4)

  discount Decimal @default(0) @db.Decimal(12, 2)
  deposit  Decimal @default(0) @db.Decimal(12, 2)

  approvalMethod RepairOrderApprovalMethod?
  approvalDate   DateTime?
  approvedBy     String?
  approvedAmount Decimal?                   @db.Decimal(12, 2)
  approvalNotes  String?

  cashierStatus    RepairOrderCashierStatus @default(NOT_CASHIERED)
  cashieredDate    DateTime?
  paymentReference String?
  paymentRemote    Boolean                  @default(false)
  remainingBalance Decimal                  @default(0) @db.Decimal(12, 2)

  pickupStatus    RepairOrderPickupStatus @default(NOT_READY)
  pickupDate      DateTime?
  pickupRecipient String?
  pickupNotes     String?

  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  serviceAdvisor Membership? @relation("RepairOrderServiceAdvisor", fields: [serviceAdvisorMembershipId], references: [id], onDelete: SetNull)

  primaryTechnician Membership? @relation("RepairOrderPrimaryTechnician", fields: [primaryTechnicianMembershipId], references: [id], onDelete: SetNull)

  statusHistory RepairOrderStatusHistory[]

  laborLines RepairOrderLaborLine[]

  partLines RepairOrderPartLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, roNumber])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, vehicleId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, scheduledDate])
  @@index([organizationId, serviceAdvisorMembershipId])
  @@index([organizationId, primaryTechnicianMembershipId])
}

//************************************************************** */

model RepairOrderStatusHistory {
  id            String @id @default(cuid())
  repairOrderId String

  status         RepairOrderStatus
  previousStatus RepairOrderStatus?

  changedByMembershipId String?

  notes     String?
  automatic Boolean @default(false)

  changedAt DateTime @default(now())

  repairOrder         RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  changedByMembership Membership? @relation("RepairOrderStatusChangedBy", fields: [changedByMembershipId], references: [id], onDelete: SetNull)

  @@index([repairOrderId])
  @@index([repairOrderId, changedAt])
  @@index([changedByMembershipId])
}

//************************************************************** */

model RepairOrderSequence {
  organizationId String @id
  nextNumber     Int    @default(1001)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

//************************************************************** */

model RepairOrderLaborLine {
  id            String @id @default(cuid())
  repairOrderId String

  technicianMembershipId String?

  description String

  hours Decimal @default(0) @db.Decimal(8, 2)
  rate  Decimal @default(0) @db.Decimal(12, 2)

  completed Boolean @default(false)

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  technician Membership? @relation("RepairOrderLaborTechnician", fields: [technicianMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repairOrderId])
  @@index([technicianMembershipId])
  @@index([repairOrderId, completed])
}

//************************************************************** */

model RepairOrderPartLine {
  id            String  @id @default(cuid())
  repairOrderId String
  partId        String?

  partNumber  String
  description String

  quantity  Decimal @default(1) @db.Decimal(12, 3)
  unitPrice Decimal @default(0) @db.Decimal(12, 2)

  requiredQty  Decimal @default(1) @db.Decimal(12, 3)
  approvedQty  Decimal @default(0) @db.Decimal(12, 3)
  allocatedQty Decimal @default(0) @db.Decimal(12, 3)
  orderedQty   Decimal @default(0) @db.Decimal(12, 3)
  receivedQty  Decimal @default(0) @db.Decimal(12, 3)
  pulledQty    Decimal @default(0) @db.Decimal(12, 3)
  installedQty Decimal @default(0) @db.Decimal(12, 3)

  estimatedCost Decimal @default(0) @db.Decimal(12, 2)
  actualCost    Decimal @default(0) @db.Decimal(12, 2)

  vendorName String?

  status RepairOrderPartStatus @default(NEEDS_REVIEW)

  resolutionMethod RepairOrderPartResolutionMethod?

  blocksWork Boolean @default(true)

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  part Part? @relation(fields: [partId], references: [id], onDelete: SetNull)

  purchaseOrderLines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repairOrderId])
  @@index([partId])
  @@index([repairOrderId, status])
  @@index([repairOrderId, blocksWork])
}

//************************************************************** */

model Part {
  id             String @id @default(cuid())
  organizationId String

  partNumber    String
  oemPartNumber String?

  alternatePartNumbers String[]

  description String
  brand       String?
  category    String?

  qtyOnHand    Decimal @default(0) @db.Decimal(12, 3)
  qtyAllocated Decimal @default(0) @db.Decimal(12, 3)
  qtyOnOrder   Decimal @default(0) @db.Decimal(12, 3)

  reorderPoint Decimal @default(0) @db.Decimal(12, 3)

  costPrice Decimal @default(0) @db.Decimal(12, 2)
  sellPrice Decimal @default(0) @db.Decimal(12, 2)

  location String?

  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inventoryTransactions PartInventoryTransaction[]
  repairOrderPartLines  RepairOrderPartLine[]
  purchaseOrderLines    PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, partNumber])
  @@index([organizationId])
  @@index([organizationId, oemPartNumber])
  @@index([organizationId, brand])
  @@index([organizationId, category])
  @@index([organizationId, isActive])
}

//************************************************************** */

model PartInventoryTransaction {
  id     String @id @default(cuid())
  partId String

  type PartInventoryTransactionType

  quantity Decimal @db.Decimal(12, 3)

  onHandBefore Decimal @db.Decimal(12, 3)
  onHandAfter  Decimal @db.Decimal(12, 3)

  allocatedBefore Decimal @db.Decimal(12, 3)
  allocatedAfter  Decimal @db.Decimal(12, 3)

  onOrderBefore Decimal @db.Decimal(12, 3)
  onOrderAfter  Decimal @db.Decimal(12, 3)

  referenceType String?
  referenceId   String?

  notes String?

  createdByMembershipId String?

  part Part @relation(fields: [partId], references: [id], onDelete: Cascade)

  createdByMembership Membership? @relation("PartInventoryTransactionCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([partId])
  @@index([partId, createdAt])
  @@index([createdByMembershipId])
  @@index([referenceType, referenceId])
}

//************************************************************** */
model Vendor {
  id             String @id @default(cuid())
  organizationId String

  name String

  accountNumber String?

  email String?
  phone String?

  website String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  contactName  String?
  contactEmail String?
  contactPhone String?

  notes String?

  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([organizationId, accountNumber])
}

//************************************************************** */

model PurchaseOrder {
  id             String @id @default(cuid())
  organizationId String
  vendorId       String

  poNumber Int

  status PurchaseOrderStatus @default(DRAFT)

  orderedAt  DateTime?
  expectedAt DateTime?
  receivedAt DateTime?

  vendorReference String?

  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  taxAmount    Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  lines PurchaseOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, poNumber])
  @@index([organizationId])
  @@index([organizationId, vendorId])
  @@index([organizationId, status])
  @@index([organizationId, orderedAt])
}

//************************************************************** */

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  partId          String

  repairOrderPartLineId String?

  partNumber  String
  description String

  orderedQty  Decimal @db.Decimal(12, 3)
  receivedQty Decimal @default(0) @db.Decimal(12, 3)

  unitCost Decimal @default(0) @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  part Part @relation(fields: [partId], references: [id], onDelete: Restrict)

  repairOrderPartLine RepairOrderPartLine? @relation(fields: [repairOrderPartLineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([partId])
  @@index([repairOrderPartLineId])
}

//************************************************************** */

model PurchaseOrderSequence {
  organizationId String @id
  nextNumber     Int    @default(1001)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

//************************************************************** */
