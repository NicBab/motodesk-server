generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  SERVICE_ADVISOR
  TECHNICIAN
  PARTS
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SessionRevocationReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  PASSWORD_RESET
  TOKEN_REUSE
  ADMIN_REVOKED
  EXPIRED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum VehicleType {
  MOTORCYCLE
  ATV
  UTV
  SCOOTER
  PWC
  SNOWMOBILE
}

enum VehicleClassification {
  NEW
  USED
  SERVICE
}

enum VehicleInventoryStatus {
  AVAILABLE
  RESERVED
  PENDING_SALE
  SOLD
  WHOLESALE
  UNAVAILABLE
}

enum RepairOrderStatus {
  ESTIMATE
  AWAITING_CUSTOMER_APPROVAL
  APPROVED
  PARTS_REVIEW
  WAITING_ON_PARTS
  READY_TO_WORK
  SCHEDULED
  IN_PROGRESS
  PAUSED
  WAITING_ON_ADDITIONAL_APPROVAL
  WAITING_ON_ADDITIONAL_PARTS
  WORK_COMPLETE
  QUALITY_CHECK
  READY_FOR_PICKUP
  CASHIERED
  COMPLETED
  PICKED_UP
  CLOSED
  CANCELLED
}

enum RepairOrderPriority {
  STANDARD
  RUSH
  EMERGENCY
  HOLD
}

enum RepairOrderApprovalMethod {
  PHONE
  SMS
  EMAIL
  CUSTOMER_PORTAL
  IN_PERSON
}

enum RepairOrderCashierStatus {
  NOT_CASHIERED
  IN_PROGRESS
  COMPLETED
  VOIDED
  REVERSED
}

enum RepairOrderPickupStatus {
  NOT_READY
  READY
  COMPLETED
  REVERSED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?

  memberships Membership[]
  sessions    Session[]
  authTokens  AuthToken[]

  createdAuditEvents AuditLog[] @relation("AuditActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  email String?
  phone String?

  memberships         Membership[]
  auditLogs           AuditLog[]
  customers           Customer[]
  vehicles            Vehicle[]
  repairOrders        RepairOrder[]
  repairOrderSequence RepairOrderSequence?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model Membership {
  id             String           @id @default(cuid())
  role           MembershipRole   @default(TECHNICIAN)
  status         MembershipStatus @default(ACTIVE)
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  serviceAdvisorRepairOrders RepairOrder[] @relation("RepairOrderServiceAdvisor")

  technicianRepairOrders RepairOrder[] @relation("RepairOrderPrimaryTechnician")

  repairOrderStatusChanges RepairOrderStatusHistory[] @relation("RepairOrderStatusChangedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Session {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  userAgent String?
  ipAddress String?

  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  revokedAt     DateTime?
  revokedReason SessionRevocationReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuthToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      AuthTokenType
  tokenHash String        @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(cuid())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorUser   User?   @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  action       String
  resourceType String
  resourceId   String?

  ipAddress String?
  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@index([action])
}

model Customer {
  id             String        @id @default(cuid())
  organizationId String
  type           CustomerType  @default(INDIVIDUAL)
  vehicles       Vehicle[]
  repairOrders   RepairOrder[]
  firstName      String?
  lastName       String?
  companyName    String?

  email          String?
  phone          String?
  alternatePhone String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  notes    String?
  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, lastName])
  @@index([organizationId, companyName])
  @@index([organizationId, email])
  @@index([organizationId, phone])
}

model Vehicle {
  id             String  @id @default(cuid())
  organizationId String
  customerId     String?

  year  Int?
  make  String
  model String
  trim  String?

  vin          String?
  mileage      Int?
  color        String?
  licensePlate String?

  type         VehicleType?
  repairOrders RepairOrder[]

  classification VehicleClassification @default(SERVICE)

  inventoryStatus VehicleInventoryStatus @default(AVAILABLE)

  stockNumber String?

  listPrice Decimal? @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)

  salesperson String?

  notes    String?
  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, vin])
  @@unique([organizationId, stockNumber])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, make, model])
  @@index([organizationId, classification])
  @@index([organizationId, inventoryStatus])
}

model RepairOrder {
  id             String @id @default(cuid())
  organizationId String
  customerId     String
  vehicleId      String

  roNumber Int

  status   RepairOrderStatus   @default(ESTIMATE)
  priority RepairOrderPriority @default(STANDARD)

  serviceAdvisorMembershipId    String?
  primaryTechnicianMembershipId String?

  promisedDate  DateTime?
  scheduledDate DateTime?

  complaint String?
  notes     String?

  taxRate          Decimal? @db.Decimal(7, 4)
  shopSuppliesRate Decimal  @default(6) @db.Decimal(7, 4)

  discount Decimal @default(0) @db.Decimal(12, 2)
  deposit  Decimal @default(0) @db.Decimal(12, 2)

  approvalMethod RepairOrderApprovalMethod?
  approvalDate   DateTime?
  approvedBy     String?
  approvedAmount Decimal?                   @db.Decimal(12, 2)
  approvalNotes  String?

  cashierStatus    RepairOrderCashierStatus @default(NOT_CASHIERED)
  cashieredDate    DateTime?
  paymentReference String?
  paymentRemote    Boolean                  @default(false)
  remainingBalance Decimal                  @default(0) @db.Decimal(12, 2)

  pickupStatus    RepairOrderPickupStatus @default(NOT_READY)
  pickupDate      DateTime?
  pickupRecipient String?
  pickupNotes     String?

  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  serviceAdvisor Membership? @relation("RepairOrderServiceAdvisor", fields: [serviceAdvisorMembershipId], references: [id], onDelete: SetNull)

  primaryTechnician Membership? @relation("RepairOrderPrimaryTechnician", fields: [primaryTechnicianMembershipId], references: [id], onDelete: SetNull)

  statusHistory RepairOrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, roNumber])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, vehicleId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, scheduledDate])
  @@index([organizationId, serviceAdvisorMembershipId])
  @@index([organizationId, primaryTechnicianMembershipId])
}

model RepairOrderStatusHistory {
  id            String @id @default(cuid())
  repairOrderId String

  status         RepairOrderStatus
  previousStatus RepairOrderStatus?

  changedByMembershipId String?

  notes     String?
  automatic Boolean @default(false)

  changedAt DateTime @default(now())

  repairOrder         RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  changedByMembership Membership? @relation("RepairOrderStatusChangedBy", fields: [changedByMembershipId], references: [id], onDelete: SetNull)

  @@index([repairOrderId])
  @@index([repairOrderId, changedAt])
  @@index([changedByMembershipId])
}

model RepairOrderSequence {
  organizationId String @id
  nextNumber     Int    @default(1001)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}
