//************************************************************** */

enum BillingSubscriptionStatus {
  NOT_SUBSCRIBED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

//************************************************************** */

enum BillingUserCapacityChangeStatus {
  QUOTED
  PROCESSING
  PENDING_PAYMENT
  APPLIED
  REJECTED
  EXPIRED
  RECONCILIATION_REQUIRED
}

//************************************************************** */

enum BillingPlanChangeStatus {
  QUOTED
  PROCESSING
  PENDING_PAYMENT
  APPLIED
  REJECTED
  EXPIRED
  RECONCILIATION_REQUIRED
}

//************************************************************** */

model OrganizationBilling {
  id String @id @default(cuid())

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  stripePriceId        String?

  // Validated against the server billing plan catalog.
  planId String?

  status BillingSubscriptionStatus @default(NOT_SUBSCRIBED)

  // Base subscription price in minor currency units.
  currency   String?
  unitAmount Int?

  // Purchased users beyond the plan's included users.
  additionalUserQuantity      Int     @default(0)
  additionalUserUnitAmount    Int?
  stripeAdditionalUserPriceId String?
  stripeAdditionalUserItemId  String?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelAt          DateTime?
  canceledAt        DateTime?
  endedAt           DateTime?

  // Retained across subscription changes to prevent repeat trials.
  trialStartedAt DateTime?
  trialEndsAt    DateTime?

  checkoutOperationId      String?   @unique
  checkoutSessionId        String?   @unique
  checkoutSessionExpiresAt DateTime?

  // Application-managed operation identifiers. Services must
  // verify record ownership and serialize both kinds of changes
  // using the existing organization-then-billing lock order.
  activeUserCapacityChangeId String? @unique
  activePlanChangeId         String? @unique

  userCapacityChanges BillingUserCapacityChange[]
  planChanges         BillingPlanChange[]

  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([planId, status])
}

//************************************************************** */

model BillingUserCapacityChange {
  // Also used to derive this operation's Stripe idempotency key.
  id String @id @default(uuid())

  organizationBillingId String
  organizationBilling   OrganizationBilling @relation(fields: [organizationBillingId], references: [id], onDelete: Cascade)

  // Retain the requesting user's identifier without copying their
  // profile or credentials. Authorization is rechecked on confirmation.
  requestedByUserId String

  status BillingUserCapacityChangeStatus @default(QUOTED)

  // Immutable Stripe mapping captured by the preview.
  stripeCustomerId     String
  stripeSubscriptionId String

  expectedAdditionalUserQuantity Int
  targetAdditionalUserQuantity   Int

  expectedLastSyncedAt DateTime?

  // Fixed timestamp shared by preview and confirmed Stripe request.
  prorationDate Int

  currency String

  // Integer minor-currency amounts. BigInt avoids overflow when
  // multiplying a valid user quantity by its recurring price.
  // Public responses must explicitly convert validated safe values.
  estimatedAmountDue BigInt
  monthlyTotalAmount BigInt

  // Server-generated Stripe update parameters only.
  // Never store arbitrary client input, tokens, or payment details.
  // Persisting them keeps retries identical to the confirmed request.
  stripeUpdateParameters Json

  // A preview expires before an unsubmitted change can be confirmed.
  expiresAt DateTime

  // Records when a Stripe submission could first have occurred.
  // Old uncertain operations must be reconciled rather than retried
  // after Stripe's idempotency retention window.
  submittedAt DateTime?

  stripeInvoiceId String?
  appliedAt       DateTime?

  // Application-defined codes only; never raw Stripe error payloads.
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationBillingId, createdAt])
  @@index([organizationBillingId, status])
  @@index([status, expiresAt])
}

//************************************************************** */

model BillingPlanChange {
  // Also used to derive this operation's Stripe idempotency key.
  id String @id @default(uuid())

  organizationBillingId String
  organizationBilling   OrganizationBilling @relation(fields: [organizationBillingId], references: [id], onDelete: Cascade)

  // Authorization is rechecked before confirmation.
  requestedByUserId String

  status BillingPlanChangeStatus @default(QUOTED)

  // Immutable mapping and expected subscription state.
  stripeCustomerId     String
  stripeSubscriptionId String
  expectedStripePriceId String

  // Plan identifiers are validated against the server catalog.
  expectedPlanId String
  targetPlanId   String

  // Targets are totals, not increments.
  expectedAdditionalUserQuantity Int
  targetAdditionalUserQuantity   Int

  expectedLastSyncedAt DateTime?

  // Fixed timestamp shared by preview and confirmed Stripe request.
  prorationDate Int

  currency String

  // Stripe's invoice estimate and the target recurring list price,
  // both expressed in integer minor-currency units.
  estimatedAmountDue BigInt
  monthlyTotalAmount BigInt

  // Server-created, validated update parameters only.
  // Repeated submissions must reuse this exact request.
  stripeUpdateParameters Json

  expiresAt   DateTime
  submittedAt DateTime?

  stripeInvoiceId String?
  appliedAt       DateTime?

  // Application-defined codes only; never raw provider errors.
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationBillingId, createdAt])
  @@index([organizationBillingId, status])
  @@index([status, expiresAt])
}

//************************************************************** */

model StripeWebhookEvent {
  id String @id

  type           String
  livemode       Boolean
  eventCreatedAt DateTime

  // Identifiers and processing state, not raw payloads.
  stripeObjectId String?

  processingToken      String?
  processingLeaseUntil DateTime?
  attemptCount         Int       @default(0)

  processedAt DateTime?

  // Application-defined failure code only.
  lastErrorCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([processedAt, processingLeaseUntil])
  @@index([type, eventCreatedAt])
}

