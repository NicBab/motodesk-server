//************************************************************** */

enum SaleType {
  POS
  RO
  REFUND
}

//************************************************************** */

enum SaleLineType {
  PART
  LABOR
}

//************************************************************** */

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOID
}

//************************************************************** */

enum SalePaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  CHECK
  ACH
  EXTERNAL_TERMINAL
  SPLIT
}

//************************************************************** */

enum SaleReturnReason {
  WRONG_PART
  DEFECTIVE_PART
  WARRANTY
  CUSTOMER_CANCELLED
  DUPLICATE_SALE
  PRICING_ADJUSTMENT
  LABOR_REFUND
  GOODWILL
  INVENTORY_CORRECTION
  OTHER
}

//************************************************************** */

enum SaleReturnDisposition {
  RETURN_TO_INVENTORY
  SCRAP_NON_RESELLABLE
}

//************************************************************** */

model Sale {
  id             String @id @default(cuid())
  organizationId String

  saleNumber Int

  type   SaleType   @default(POS)
  status SaleStatus @default(COMPLETED)

  customerId   String?
  customerName String

  repairOrderId String?
  roNumber      Int?

  subtotal Decimal @default(0) @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  discountReason String?

  taxRate   Decimal @default(0) @db.Decimal(7, 4)
  taxAmount Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @default(0) @db.Decimal(12, 2)

  refundedTotal Decimal @default(0) @db.Decimal(12, 2)

  paymentMethod SalePaymentMethod

  cashierMembershipId String?
  cashierName         String?

  originalSaleId     String?
  originalSaleNumber Int?

  returnReason      SaleReturnReason?
  returnDisposition SaleReturnDisposition?

  managerNotes String?

  processedByMembershipId String?
  processedByName         String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  repairOrder RepairOrder? @relation(fields: [repairOrderId], references: [id], onDelete: SetNull)

  originalSale Sale? @relation("SaleRefunds", fields: [originalSaleId], references: [id], onDelete: SetNull)

  refunds Sale[] @relation("SaleRefunds")

  lines SaleLine[]

  payments SalePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, saleNumber])
  @@index([organizationId])
  @@index([organizationId, type])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([customerId])
  @@index([repairOrderId])
  @@index([originalSaleId])
}

//************************************************************** */

model SaleLine {
  id     String @id @default(cuid())
  saleId String

  type SaleLineType

  partId String?

  originalSaleLineId String?

  partNumber String?

  description String

  quantity Decimal @db.Decimal(12, 3)

  unitPrice Decimal @db.Decimal(12, 2)

  returnedQty Decimal @default(0) @db.Decimal(12, 3)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  part Part? @relation(fields: [partId], references: [id], onDelete: SetNull)

  originalSaleLine SaleLine? @relation("SaleLineReturns", fields: [originalSaleLineId], references: [id], onDelete: SetNull)

  returnLines SaleLine[] @relation("SaleLineReturns")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([partId])
  @@index([originalSaleLineId])
}

//************************************************************** */

model SalePayment {
  id     String @id @default(cuid())
  saleId String

  method SalePaymentMethod

  amount Decimal @db.Decimal(12, 2)

  reference String?

  remote Boolean @default(false)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([saleId])
}

//************************************************************** */

model SaleSequence {
  organizationId String @id

  nextNumber Int @default(1001)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt
}

//************************************************************** */
