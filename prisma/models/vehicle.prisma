//************************************************************** */

enum VehicleType {
  MOTORCYCLE
  ATV
  UTV
  SCOOTER
  PWC
  SNOWMOBILE
}

//************************************************************** */

enum VehicleClassification {
  NEW
  USED
  SERVICE
}

//************************************************************** */

enum VehicleInventoryStatus {
  AVAILABLE
  RESERVED
  PENDING_SALE
  SOLD
  WHOLESALE
  UNAVAILABLE
}

//************************************************************** */

model Vehicle {
  id             String  @id @default(cuid())
  organizationId String
  customerId     String?

  year  Int?
  make  String
  model String
  trim  String?

  vin          String?
  mileage      Int?
  color        String?
  licensePlate String?

  type         VehicleType?
  repairOrders RepairOrder[]

  classification VehicleClassification @default(SERVICE)

  inventoryStatus VehicleInventoryStatus @default(AVAILABLE)

  stockNumber String?

  listPrice Decimal? @db.Decimal(12, 2)
  unitCost  Decimal? @db.Decimal(12, 2)

  salesperson String?

  notes    String?
  isActive Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, vin])
  @@unique([organizationId, stockNumber])
  @@index([organizationId])
  @@index([organizationId, customerId])
  @@index([organizationId, make, model])
  @@index([organizationId, classification])
  @@index([organizationId, inventoryStatus])
}

//************************************************************** */
