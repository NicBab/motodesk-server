//************************************************************** */

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

//************************************************************** */

model Organization {
  id     String             @id @default(cuid())
  name   String
  slug   String             @unique
  email  String?
  phone  String?
  status OrganizationStatus @default(ACTIVE)

  memberships                   Membership[]
  membershipInvitations         MembershipInvitation[]
  auditLogs                     AuditLog[]
  customers                     Customer[]
  vehicles                      Vehicle[]
  repairOrders                  RepairOrder[]
  parts                         Part[]
  vendors                       Vendor[]
  purchaseOrders                PurchaseOrder[]
  purchaseOrderReceipts         PurchaseOrderReceipt[]
  partReturns                   PartReturn[]
  schedules                     Schedule[]
  technicianAssignments         TechnicianAssignment[]
  serviceBays                   ServiceBay[]
  serviceBayAssignments         ServiceBayAssignment[]
  repairOrderLaborCancellations RepairOrderLaborCancellation[]
  membershipPermissions         MembershipPermission[]
  purchaseOrderSequence         PurchaseOrderSequence?
  partReturnSequence            PartReturnSequence?
  repairOrderSequence           RepairOrderSequence?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

//************************************************************** */
