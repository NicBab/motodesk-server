//************************************************************** */

enum ScheduleStatus {
  TENTATIVE
  SCHEDULED
  CONFIRMED
  READY
  IN_PROGRESS
  PAUSED
  BLOCKED
  COMPLETED
  CANCELLED
  MISSED
  RESCHEDULE_REQUIRED
}

//************************************************************** */

model Schedule {
  id             String @id @default(cuid())
  organizationId String
  repairOrderId  String

  technicianEmployeeId String?
  laborLineId          String?

  scheduledDate DateTime
  scheduledEnd  DateTime?

  promisedDate DateTime?

  status ScheduleStatus @default(SCHEDULED)

  waitingCustomer Boolean @default(false)

  actualStartedAt   DateTime?
  actualCompletedAt DateTime?

  cancelledAt       DateTime?
  cancellationNotes String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  repairOrder RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)

  technicianEmployee Employee? @relation(fields: [technicianEmployeeId], references: [id], onDelete: Restrict)

  laborLine RepairOrderLaborLine? @relation(fields: [laborLineId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([repairOrderId])
  @@index([organizationId, scheduledDate])
  @@index([organizationId, scheduledEnd])
  @@index([organizationId, technicianEmployeeId])
  @@index([organizationId, technicianEmployeeId, scheduledDate])
  @@index([organizationId, status])
  @@index([repairOrderId, status])
  @@index([laborLineId])
}

//************************************************************** */
